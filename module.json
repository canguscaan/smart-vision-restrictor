{
  "id": "smart-vision-restrictor",
  "title": "Smart Vision Restrictor",
  "description": "Applies a GM-configured hard maximum vision range for scenes, useful for fog, smoke, haze, blizzards, magical obscurity, or large open maps. The range is interpreted in the scene's configured distance units.",
  "version": "0.1.0",
  "url": "https://github.com/canguscaan/smart-vision-restrictor",
  "manifest": "https://github.com/canguscaan/smart-vision-restrictor/releases/latest/download/module.json",
  "download": "https://github.com/canguscaan/smart-vision-restrictor/releases/latest/download/smart-vision-restrictor.zip",
  "authors": [
    {
      "name": "Chris",
      "url": "https://github.com/canguscaan"
    },
    {
      "name": "Canguscaan",
      "url": "https://github.com/canguscaan"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.3",
          "verified": "5.3.3"
        }
      }
    ],
    "recommends": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Recommended for safer interoperability with other modules that wrap Foundry token and vision methods. Vision Restrictor falls back to direct wrapping if libWrapper is not installed."
      }
    ]
  },
  "esmodules": [
    "scripts/vision-restrictor.js"
  ],
  "styles": [
    "styles/vision-restrictor.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "license": "LICENSE",
  "readme": "README.md",
  "bugs": "https://github.com/canguscaan/smart-vision-restrictor/issues",
  "changelog": "https://github.com/canguscaan/smart-vision-restrictor/releases",
  "library": false
}
